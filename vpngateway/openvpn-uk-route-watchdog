#!/bin/sh
set -eu

CONFIG_FILE=${WATCHDOG_CONFIG_FILE:-/etc/default/openvpn-uk-route-watchdog}
[ -r "$CONFIG_FILE" ] || exit 1
. "$CONFIG_FILE"

: "${REMOTE:?}"
: "${GATEWAY:?}"
: "${IFACE:?}"
: "${SERVICE:?}"

TUN_IFACE=${TUN_IFACE:-tun0}
TUN_GATEWAY=${TUN_GATEWAY:-}
TAG="openvpn-uk-route-watchdog"
STATE_DIR="/var/lib/openvpn-uk-route-watchdog"
FAILED="$STATE_DIR/tunnel-probe-failed"
LAST_RESTART="$STATE_DIR/last-tunnel-restart"
NETWORK_RECOVERY="/run/pi-network-recovery-watchdog/recovery-active"
DEFER_MARKER="$STATE_DIR/network-recovery-deferred"

log() {
    logger -t "$TAG" "$*" || true
}

epoch_file() {
    [ -r "$1" ] && sed -n '1p' "$1" 2>/dev/null || printf 0
}

primary_ready() {
    [ -d "/sys/class/net/$IFACE" ] || return 1
    [ "$(cat "/sys/class/net/$IFACE/carrier" 2>/dev/null || printf 0)" = 1 ] || return 1
    ip link show dev "$IFACE" 2>/dev/null | grep -q "state UP" || return 1
    ping -I "$IFACE" -c 1 -W 1 "$GATEWAY" >/dev/null 2>&1
}

route_ready() {
    ip -4 route get "$REMOTE" 2>/dev/null | grep -q "via $GATEWAY dev $IFACE"
}

tunnel_ready() {
    [ -n "$TUN_GATEWAY" ] || return 0
    ip link show dev "$TUN_IFACE" >/dev/null 2>&1 || return 1
    ping -I "$TUN_IFACE" -c 1 -W 2 "$TUN_GATEWAY" >/dev/null 2>&1
}

if [ "${1:-run}" = check ]; then
    service=inactive
    route=bad
    tunnel=bad
    systemctl is-active --quiet "$SERVICE" && service=active
    route_ready && route=healthy
    tunnel_ready && tunnel=healthy
    printf 'openvpn=%s route=%s tunnel=%s\n' "$service" "$route" "$tunnel"
    [ "$service" = active ] && [ "$route" = healthy ] && [ "$tunnel" = healthy ]
    exit
fi

mkdir -p "$STATE_DIR"
if [ -f "$NETWORK_RECOVERY" ]; then
    if [ ! -f "$DEFER_MARKER" ]; then
        : > "$DEFER_MARKER"
        log "generic network recovery is active; deferring OpenVPN actions"
    fi
    exit 0
fi

if ! primary_ready; then
    if [ ! -f "$DEFER_MARKER" ]; then
        : > "$DEFER_MARKER"
        log "primary interface is unhealthy; generic recovery owns network actions"
    fi
    exit 0
fi

if ! systemctl is-active --quiet "$SERVICE"; then
    log "$SERVICE is inactive; restarting service"
    systemctl restart "$SERVICE" || log "restart command returned an error"
    exit 0
fi

if ! route_ready; then
    log "OpenVPN remote route is not pinned to $IFACE; restarting service"
    systemctl restart "$SERVICE" || log "restart command returned an error"
    exit 0
fi

if tunnel_ready; then
    rm -f "$DEFER_MARKER" "$FAILED"
    exit 0
fi

now=$(date +%s)
first=$(epoch_file "$FAILED")
if [ "$first" = 0 ]; then
    printf '%s\n' "$now" > "$FAILED"
    log "OpenVPN tunnel probe failed; waiting for confirmation"
    exit 0
fi

[ $((now - first)) -lt 20 ] && exit 0
last=$(epoch_file "$LAST_RESTART")
if [ $((now - last)) -lt 120 ]; then
    log "OpenVPN tunnel probe remains unhealthy; restart rate limit is active"
    exit 0
fi

printf '%s\n' "$now" > "$LAST_RESTART"
log "OpenVPN tunnel probe failed twice; restarting $SERVICE"
systemctl restart "$SERVICE" || log "restart command returned an error"
rm -f "$FAILED"
